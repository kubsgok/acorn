{
  "expo": {
    "name": "Acorn Labs",
    "slug": "acorn-labs",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "acornlabs",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.acornlabs.app"
    },
    "android": {
      "package": "com.acornlabs.app",
      "adaptiveIcon": {
        "backgroundColor": "#f0e5c5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
