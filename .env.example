# Copy to .env.local (git-ignored). Values here are placeholders.
# EXPO_PUBLIC_* values are bundled into the app — NEVER put a secret here.
# The app refuses to start with a service_role / sb_secret_ key (see src/lib/config.ts).
EXPO_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
# Publishable (sb_publishable_…) or legacy anon key from your DEV project.
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-key
EXPO_PUBLIC_TERMS_URL=https://example.com/terms
